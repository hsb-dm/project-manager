# ZenCrevia server security configuration
NODE_ENV=production
PORT=3000
APP_URL=https://zencrevia.example.com

# Docker bind-mount ownership. On the VPS set these to `id -u` and `id -g`
# for the account that owns COS_DATA_HOST_PATH (usually both are 1000).
LOCAL_UID=1000
LOCAL_GID=1000
# COS_DATA_HOST_PATH=./data

# Set these before the first production start. Use unique random values.
COS_ADMIN_PASSWORD=replace-with-a-strong-password
COS_SECRET_KEY=replace-with-at-least-32-random-characters
COS_BACKUP_KEY=replace-with-a-different-32-character-secret

# First start on an empty database (v29). Production creates a clean workspace with
# only this admin account; set COS_SEED_DEMO=1 to load the demo workspace instead.
COS_ADMIN_NAME=Admin
COS_ADMIN_EMAIL=admin@your-company.com
# COS_SEED_DEMO=0

# Account and session policy
COS_ALLOW_REGISTRATION=0
COS_INVITE_CODE=replace-only-if-registration-is-enabled
# A session ends this many hours after it was last USED (default 1440 = 60 days).
COS_SESSION_HOURS=1440
# Using the app pushes the end back, at most once per this many hours.
COS_SESSION_RENEW_HOURS=24
COS_SECURE_COOKIE=1
COS_ALLOWED_ORIGINS=https://zencrevia.example.com
COS_TRUST_PROXY=1
COS_ALLOW_IMPERSONATION=0
# COS_CONFIRM_RESET=YES   # temporary emergency override; keep unset normally

# Data, uploads, logs, and encrypted backups
COS_DATA_DIR=./data
COS_MAX_BODY_BYTES=12000000
COS_BACKUP_DIR=./data/backups
COS_BACKUP_KEEP=14
# Automatic backups follow Settings -> Backup & Data -> Automatic Backups (default daily
# in production). Set this only to force a fixed interval; the dashboard then shows it
# as "set by server". 0 disables automatic backups.
# COS_BACKUP_INTERVAL_HOURS=24
# COS_SECURITY_LOG=./data/security.log
# COS_SECURITY_LOG_MAX_MB=10     # rotate security.log past this size
# COS_SECURITY_LOG_KEEP=5        # rotated files kept
# COS_OUTBOX_DAYS=14             # "log" mail transport keeps this many days of .eml
# COS_OUTBOX_MAX=1000

# Password reset links (Forgot password?) expire after this many minutes.
# COS_RESET_MINUTES=60
# Tasks finished longer ago than this are sent slim at sign-in and loaded fully on open.
# COS_TASK_HOT_DAYS=45
# Chat messages one person may send per 30 seconds.
# COS_MSG_RATE_MAX=30

# Add a hostname only after reviewing the AI provider and its data terms.
# COS_AI_ALLOWED_HOSTS=custom-ai.example.com

# Email: log, smtp, or resend
COS_MAIL_TRANSPORT=log
MAIL_FROM=ZenCrevia <no-reply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0
# RESEND_API_KEY=

# Public legal pages at /privacy and /terms (server/legal.js). Google requires these before an
# OAuth app can leave "Testing". Without them the pages still render, using ZenCrevia and an
# address derived from APP_URL's hostname.
# COS_LEGAL_ENTITY=PT Your Company
# COS_LEGAL_CONTACT=privacy@yourdomain.com
# COS_LEGAL_JURISDICTION=Indonesia

# Uploads to the shared Google Drive account (server/gdrive.js) stream straight through this
# server, so they are not limited by the disk here. Default 300 MB per file.
# COS_DRIVE_MAX_BYTES=314572800

# Server file storage (server/filestore.js) — used when Settings → Integrations → File storage is
# set to "This server". Per-file limit in bytes; the default is 5 MB.
# COS_FILE_MAX_BYTES=5242880

# ---- Rarely changed, documented so they can be found ----

# Sign-in throttle (server/security.js). Defaults: 5 attempts per 15 minutes, 10000 tracked keys.
# COS_LOGIN_MAX_ATTEMPTS=5
# COS_LOGIN_WINDOW_MS=900000
# COS_LOGIN_MAX_KEYS=10000

# Accept an X-User-Id header instead of signing in. For local development only — it is ignored
# when NODE_ENV=production, and it is a full authentication bypass wherever it is honoured.
# COS_DEV_HEADER_AUTH=1
# COS_ALLOW_HEADER_AUTH=1

# Allow SMTP password auth over an unencrypted connection to a remote host (server/mailer.js).
# Off by default; localhost is always allowed. Leave unset unless the mail server needs it.
# COS_SMTP_ALLOW_PLAINTEXT_AUTH=1

# Write every email to data/outbox instead of sending it, even with SMTP configured.
# COS_MAIL_FORCE_LOG=1

# Password for the seeded demo accounts (server/seed.js). Leave unset outside a demo install.
# COS_DEMO_PASSWORD=

# Restoring a backup from the command line overwrites the live database, so it refuses to run
# without this (server/backup.js).
# COS_CONFIRM_RESTORE=YES

# Output resolution for Freepik Mystic image generation. "2k" by default.
# COS_MYSTIC_RESOLUTION=2k
